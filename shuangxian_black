<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  width: 100%;
  height: 100%;
  background: transparent;
}

.player {
  width: 100%;
  height: 100%;
  padding: 8px;
  display: flex;
  align-items: center;
}

.box {
  width: 100%;
  padding: 14px 18px;
  color: #000000;
  background: transparent;
  font-family: 'Songti SC', 'Noto Serif SC', 'STSong', 'SimSun', serif;
}

.wire-row {
  position: relative;
  height: 64px;
  margin-bottom: 6px;
}

.line {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  z-index: 1;
  pointer-events: none;
  transform-origin: center;
  animation: line-breathe 5s ease-in-out infinite;
}

@keyframes line-breathe {
  0%, 100% { opacity: 0.7; transform: scale(1); }
  50%      { opacity: 1;   transform: scale(1.012); }
}

.line .back,
.line .front {
  fill: none;
  stroke: #000000;
  stroke-linecap: round;
}

.line .back {
  stroke-width: 0.35;
  opacity: 0.45;
  stroke-dasharray: 14 12;
  animation: flow-back 2.6s linear infinite;
}

.line .front {
  stroke-width: 0.5;
  opacity: 1;
  stroke-dasharray: 20 8;
  animation: flow-front 2.2s linear infinite;
}

@keyframes flow-back {
  from { stroke-dashoffset: 0px; }
  to   { stroke-dashoffset: -26px; }
}

@keyframes flow-front {
  from { stroke-dashoffset: 0px; }
  to   { stroke-dashoffset: -28px; }
}

.avatar-wrap {
  position: absolute;
  top: 12px;
  width: 40px;
  height: 40px;
  z-index: 2;
}

.avatar-left {
  left: calc(33.33% - 20px);
  animation: float-left 4s ease-in-out infinite;
}

.avatar-right {
  left: calc(66.67% - 20px);
  animation: float-right 4s ease-in-out infinite;
}

@keyframes float-left {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(4px); }
}

@keyframes float-right {
  0%, 100% { transform: translateX(0); }
  50%      { transform: translateX(-4px); }
}

.avatar {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  overflow: hidden;
  background: #000000;
  box-shadow:
    inset 0 1px 2px rgba(255, 255, 255, 0.35),
    inset 0 -2px 4px rgba(0, 0, 0, 0.18),
    0 3px 8px rgba(0, 0, 0, 0.18);
}

.avatar img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  background: transparent;
}

.avatar::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  pointer-events: none;
  background:
    radial-gradient(circle at 32% 26%, rgba(255, 255, 255, 0.3) 0%, rgba(255, 255, 255, 0) 40%),
    radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0) 62%, rgba(0, 0, 0, 0.14) 100%);
}

.staff-note {
  position: absolute;
  margin-left: -0.3em;
  font-size: 11px;
  line-height: 1;
  color: #000000;
  text-shadow: 0 0 5px rgba(0, 0, 0, 0.4), 0 0 10px rgba(0, 0, 0, 0.2);
  animation: note-bob 2.4s ease-in-out infinite;
  z-index: 3;
}

.n1 { left: 40%; top: 0px; }
.n2 { left: 50%; top: 6px; animation-delay: 0.8s; }
.n3 { left: 60%; top: 0px; animation-delay: 1.6s; }

@keyframes note-bob {
  0%, 100% { transform: translateY(0); }
  50%      { transform: translateY(-3px); }
}

.title {
  text-align: center;
  font-size: 12px;
  font-weight: 400;
  -webkit-text-stroke: 0.15px #000000;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #000000;
  text-shadow: 0 0 6px rgba(0, 0, 0, 0.35), 0 0 12px rgba(0, 0, 0, 0.2);
  animation: glow 3s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.7; }
}

.time {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 3px;
  font-size: 8px;
  font-weight: 400;
  color: #000000;
  margin-bottom: 9px;
  animation: bottom-glow 5s ease-in-out infinite;
}

@keyframes bottom-glow {
  0%, 100% { text-shadow: 0 0 4px rgba(0, 0, 0, 0.2), 0 0 8px rgba(0, 0, 0, 0.1); }
  50%      { text-shadow: 0 0 8px rgba(0, 0, 0, 0.55), 0 0 16px rgba(0, 0, 0, 0.3); }
}

.clock {
  display: inline-flex;
  align-items: flex-start;
}

.roll {
  display: inline-block;
  height: 1em;
  line-height: 1em;
  overflow: hidden;
  text-align: center;
  width: 0.6em;
}

.strip {
  display: block;
}

.strip span {
  display: block;
  height: 1em;
  line-height: 1em;
}

.roll-min .strip { animation: roll-min 320s linear infinite; }
.roll-ten .strip { animation: roll-ten 320s steps(32, end) infinite; }
.roll-unit .strip { animation: roll-unit 10s steps(10, end) infinite; }

@keyframes roll-min {
  0%, 18.7%     { transform: translateY(0); }
  18.8%, 37.4%  { transform: translateY(-1em); }
  37.5%, 56.1%  { transform: translateY(-2em); }
  56.2%, 74.8%  { transform: translateY(-3em); }
  74.9%, 93.5%  { transform: translateY(-4em); }
  93.6%, 100%   { transform: translateY(-5em); }
}

@keyframes roll-ten {
  from { transform: translateY(0); }
  to   { transform: translateY(-32em); }
}

@keyframes roll-unit {
  from { transform: translateY(0); }
  to   { transform: translateY(-10em); }
}

.colon {
  line-height: 1em;
}

.bar {
  width: 100%;
  height: 3px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 2px;
  overflow: hidden;
  margin-bottom: 10px;
}

.fill {
  height: 100%;
  width: 0;
  background: #000000;
  animation: progress 320s linear infinite;
}

@keyframes progress {
  from { width: 0; }
  to   { width: 100%; }
}

.controls {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #000000;
}

.controls span {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  animation: shadow-breathe 4.5s ease-in-out infinite;
}

@keyframes shadow-breathe {
  0%, 100% { text-shadow: 0 0 6px rgba(0, 0, 0, 0.35), 0 0 12px rgba(0, 0, 0, 0.2); }
  50%      { text-shadow: 0 0 6px rgba(0, 0, 0, 0.08), 0 0 12px rgba(0, 0, 0, 0.04); }
}

.heart {
  display: block;
  width: 12px;
  height: 12px;
  fill: #000000;
  animation: icon-breathe 4.5s ease-in-out infinite;
}

.pause {
  display: inline-flex;
  gap: 3px;
  animation: icon-breathe 4.5s ease-in-out infinite;
}

.pause i {
  display: block;
  width: 3px;
  height: 10px;
  background: #000000;
  box-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
}

@keyframes icon-breathe {
  0%, 100% { filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.5)); }
  50%      { filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.08)); }
}

.controls .last {
  font-size: 12px;
  -webkit-text-stroke: 0.4px #000000;
}
</style>

